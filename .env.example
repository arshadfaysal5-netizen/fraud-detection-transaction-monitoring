# ------------------------------------------------------------------
# Real-Time Fraud Detection & Transaction Monitoring System
# Copy to .env and adjust for your environment.
# NEVER commit .env
# ------------------------------------------------------------------

# --- App ---
APP_NAME=real-time-fraud-detection
ENVIRONMENT=development
DEBUG=true
API_ORIGIN=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# --- Security ---
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=change-me-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- Database (PostgreSQL) ---
POSTGRES_DB=fraud_monitor
POSTGRES_USER=fraud_app
POSTGRES_PASSWORD=fraud_app_pw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://fraud_app:fraud_app_pw@postgres:5432/fraud_monitor

# --- Cache (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# --- Streaming (Kafka, KRaft) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_TX_INGEST=tx.ingest
KAFKA_TOPIC_TX_DECISIONS=tx.decisions
KAFKA_TOPIC_ALERTS=alerts
KAFKA_TOPIC_AUDIT=audit
KAFKA_TOPIC_ML_FEATURES=ml.features
KAFKA_CONSUMER_GROUP=fraud-engine

# --- Fraud engine ---
# Decision thresholds (risk_score 0-100)
RISK_THRESHOLD_REVIEW=50
RISK_THRESHOLD_BLOCK=80
RISK_WEIGHT_RULE=0.45
RISK_WEIGHT_ML=0.55

# --- ML ---
MODEL_PATH=/app/ml/artifacts/model.joblib